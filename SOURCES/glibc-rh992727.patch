+++ glibc-2.17-c758a686.new/benchtests/bench-strlen.c	2013-08-08 09:32:15.911662617 +0530
@@ -0,0 +1,149 @@
+/* Measure STRLEN functions.
+   Copyright (C) 2013 Free Software Foundation, Inc.
+   This file is part of the GNU C Library.
+
